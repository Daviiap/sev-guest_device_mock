#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")"

sudo apt install -y build-essential libfuse-dev libssl-dev pkg-config uuid-dev

KEYS_GEN_DIR="keys_gen"
KEYS_DIR="$KEYS_GEN_DIR/keys"
TARGET_DIR="/etc/sev-guest"

# Create target directories
sudo mkdir -p "$TARGET_DIR/vcek" "$TARGET_DIR/vlek"
echo "Created $TARGET_DIR directory"

# Install report.bin first: the device mock and keys_gen both look for it
# in $TARGET_DIR before the current directory, so the certificates must be
# generated from the same file the device will serve.
if [ -f "report.bin" ]; then
    sudo cp "report.bin" "$TARGET_DIR/"
    echo "Copied report.bin to $TARGET_DIR"
fi

# Build keys
(cd "$KEYS_GEN_DIR" && go run . -config ../config.json)

# Install the keys and certificates of each endorsement key
for ek in vcek vlek; do
    sudo install -m 600 "$KEYS_DIR/$ek/$ek.key" "$TARGET_DIR/$ek/private.pem"
    sudo install -m 644 "$KEYS_DIR/$ek/$ek.pem" "$TARGET_DIR/$ek/public.pem"
    sudo install -m 644 "$KEYS_DIR/$ek/cert_chain.pem" "$TARGET_DIR/$ek/"
    sudo install -m 644 "$KEYS_DIR/$ek/crl.der" "$TARGET_DIR/$ek/"
    echo "Copied $ek key, cert, cert chain and CRL to $TARGET_DIR/$ek"
done
